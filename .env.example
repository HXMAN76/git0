# Copy to .env and fill in. Never commit .env.
FALKORDB_URL=redis://localhost:6379
TENANT_GRAPH_PREFIX=team_
# Room cleanup (#30): delete rooms idle longer than the TTL, evict the least recently seen past MAX_ROOMS.
TENANT_TTL_SECONDS=7200
MAX_ROOMS=300
# Never deleted (JSON list of tenant ids, without the prefix).
PINNED_TENANTS=["demo"]
SWEEP_INTERVAL_S=600

# LLM: Groq primary (strict json_schema), Gemini fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_CACHE_DIR=.cache/llm
# 1 = serve cached LLM output only, no network (demo safety net, bench, CI). The bench sets LLM_CACHE_DIR=bench/cache.
LLM_OFFLINE=0
# Per-tenant LLM calls per minute, so one judge cannot burn the shared Groq quota.
LLM_TENANT_RPM=20
# Per-provider call timeout in seconds; on timeout Groq falls back to Gemini.
LLM_TIMEOUT_S=20

CORS_ORIGINS=["http://localhost:5173"]
