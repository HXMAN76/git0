# Copy to deploy/aws/membranch.env (gitignored) and fill in. Used by setup.sh only.
AWS_PROFILE=membranch            # CLI profile with your friend's account credentials (aws configure --profile membranch)
REGION=ap-south-1
GITHUB_REPO=HXMAN76/git0
INSTANCE_TYPE=t3.small           # free-plan eligible (2 GiB). t3.medium (4 GiB) needs a Paid-plan account
ALERT_EMAIL=you@example.com      # budget alerts
BUDGET_USD=30
